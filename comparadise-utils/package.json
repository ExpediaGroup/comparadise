{
  "name": "comparadise-utils",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./compare": {
      "types": "./dist/compare.d.mts",
      "default": "./dist/compare.mjs"
    },
    "./commands": "./commands.js",
    "./*": "./*"
  },
  "license": "Apache-2.0",
  "files": [
    "dist",
    "commands.js",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ExpediaGroup/comparadise.git"
  },
  "bugs": {
    "url": "https://github.com/ExpediaGroup/comparadise/issues"
  },
  "dependencies": {
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@types/pngjs": "6.0.5",
    "tsdown": "0.23.0"
  },
  "peerDependencies": {
    "cypress": ">=12"
  },
  "peerDependenciesMeta": {
    "cypress": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsdown index.ts screenshot-actions.ts create-base-image.ts compare.ts --deps.neverBundle shared",
    "postbuild": "echo \"require('./dist/screenshot-actions.mjs');\nrequire('./dist/create-base-image.mjs');\" > commands.js",
    "prepack": "bun run build",
    "test": "bun test"
  }
}
